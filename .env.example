# Names only. Never commit real values.

# Server
PORT=
# Set to 1 when a proxy terminates TLS in front of the app, so the session
# cookie is marked Secure.
TRUST_PROXY_TLS=

# Owner-only access. Without this the app refuses all use rather than
# defaulting open. The token must be at least 24 characters with real variety;
# short or well-known values (changeme, password, ...) are rejected at startup,
# so a guessable deployment refuses to serve instead of looking healthy.
# Generate one with: openssl rand -base64 32
# SESSION_SECRET signs session cookies. A weak secret makes those signatures
# forgeable, which would bypass the access token entirely, so it is held to the
# same strength rule and rejected at startup if it fails. If unset, the
# already-validated access token is used, so setting it separately is only
# needed to let sessions survive a token change.
OWNER_ACCESS_TOKEN=
SESSION_SECRET=

# Transcription provider (OpenAI-compatible /audio/transcriptions).
# The request language is set to Hebrew in code, not here.
# BASE_URL may point at a self-hosted model on a private address.
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_BASE_URL=
TRANSCRIPTION_MODEL=

# Summarization provider (OpenAI-compatible /chat/completions).
SUMMARY_API_KEY=
SUMMARY_BASE_URL=
SUMMARY_MODEL=
